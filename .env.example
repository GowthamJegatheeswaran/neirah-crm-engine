# Copy this file to .env and fill in your own values. NEVER commit .env.

# --- App ---
PORT=3000
NODE_ENV=development

# --- PostgreSQL (must match docker-compose.yml) ---
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=crm_user
DB_PASSWORD=change_me_db_password
DB_NAME=crm_db

# --- JWT ---
# Use a long random string (example: run `openssl rand -hex 32`)
JWT_SECRET=change_me_to_a_long_random_string
JWT_EXPIRES_IN=1h

# --- SLA scheduler (Day 4) ---
# true = the app checks follow-ups and SLA breaches by itself every N seconds
SCHEDULER_ENABLED=true
SLA_CHECK_INTERVAL_SECONDS=60

# --- Demo seed data only (used by `npm run seed`) ---
SEED_DEFAULT_PASSWORD=ChangeMe@123
